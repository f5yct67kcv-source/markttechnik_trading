//@version=6
// Markttechnik – GWL + Signallage (Prototyp Phase 1)
// 1:1-Port der Python-Referenz in referenz/mtref (ENT-031). Regeln: siehe ENTSCHEIDE.md.
indicator("Markttechnik GWL + Signallage (Prototyp)", "MT GWL", overlay = true, scale = scale.right,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200, max_bars_back = 5000)

// ───────────────────────────── Einstellungen
grpT = "Trend"
i_method   = input.string("Domino (Buch Z-06)", "GWL-Methode (ENT-104)", options = ["Domino (Buch Z-06)", "Variante C (Kerzenregel höhere Zeiteinheit)"], group = grpT)
i_tf       = input.timeframe("", "GWL-Zeiteinheit (leer = automatisch, ENT-085)", group = grpT)
i_thr      = input.float(38.2, "Tiefenfilter GWL in % (ENT-084)", minval = 0, maxval = 100, step = 0.1, group = grpT) / 100
i_thrSig   = input.float(38.2, "Tiefenfilter Signallage in % (ENT-101, 0 = aus)", minval = 0, maxval = 100, step = 0.1, group = grpT) / 100
i_showSig  = input.bool(true, "Signallage anzeigen (fein)", group = grpT)
i_showGwl  = input.bool(true, "GWL anzeigen (dick)", group = grpT)
i_maxSeg   = input.int(150, "Max. gezeichnete Äste je Grösse (ENT-032)", minval = 10, maxval = 200, group = grpT)
grpD = "Tageslinien (ENT-068)"
i_showDay  = input.bool(true, "Hochs/Tiefs der Vortage", group = grpD)
i_days     = input.int(5, "Anzahl Tage", minval = 1, maxval = 20, group = grpD)
i_showOpen = input.bool(true, "Eröffnung aktueller Tag", group = grpD)
grpI = "Innenstäbe / Umkehrstäbe (nur ab 10-Min-Chart)"
i_showIB   = input.bool(true, "Innenstab-Boxen (ENT-052/054)", group = grpI)
i_ibFuzz   = input.int(0, "Unschärfe Innenstab in Ticks (ENT-062)", minval = 0, group = grpI)
i_showUK   = input.bool(true, "Umkehrstäbe markieren (ENT-067/069)", group = grpI)
grpS = "Signale / Anzeige"
i_premAtr  = input.float(1.0, "Premium: Abstand ≤ x × ATR(20) (ENT-072)", minval = 0, step = 0.1, group = grpS)
i_showSigL = input.bool(true, "Einstiegssignale im Chart (ENT-073)", group = grpS)
i_showTab  = input.bool(true, "Info-Tabelle (ENT-049)", group = grpS)
grpX = "Fehlersuche (ENT-100)"
i_dbgGwl   = input.bool(true,  "Grund bei GWL-Farbwechsel anzeigen", group = grpX)
i_dbgSig   = input.bool(false, "Grund bei Signallage-Farbwechsel anzeigen", group = grpX)
i_tabPos   = input.string("Oben links", "Position Info-Tabelle", options = ["Oben links", "Links Mitte", "Unten links", "Oben rechts", "Unten rechts"], group = grpS)
TAB_POS = i_tabPos == "Oben links" ? position.top_left : i_tabPos == "Links Mitte" ? position.middle_left : i_tabPos == "Unten links" ? position.bottom_left : i_tabPos == "Oben rechts" ? position.top_right : position.bottom_right

// ───────────────────────────── Konstanten
TICK = syminfo.mintick
cUp  = color.rgb(26, 150, 65)     // grün  = Aufwärtstrend
cDn  = color.rgb(215, 25, 28)     // rot   = Abwärtstrend
cNo  = color.rgb(43, 108, 176)    // blau  = trendlos
stColor(int st) => st == 1 ? cUp : st == -1 ? cDn : cNo
stText(int st) => st == 1 ? "AUF (grün)" : st == -1 ? "AB (rot)" : "TRENDLOS (blau)"

// Nächsthöhere Stufe der Leiter aus ENT-003 (ENT-085)
autoTF() =>
    s = timeframe.in_seconds()
    s < 600 ? "10" : s < 3600 ? "60" : s < 86400 ? "D" : s < 604800 ? "W" : "M"
GWL_TF = i_tf == "" ? autoTF() : i_tf
IS_TF10 = timeframe.in_seconds() >= 600

// ───────────────────────────── Typen
type Swing
    int   kind      // 1 = Hoch, -1 = Tief
    int   bar
    float price

// Kerzenregel (ENT-065) – arbeitet auf Chart-Kerzen oder auf wachsenden Kerzen der höheren Zeiteinheit
type Finder
    int   dir  = 0
    bool  init = false
    float hiP
    float hiLow
    int   hiBar
    int   hiGrp
    float loP
    float loHigh
    int   loBar
    int   loGrp

// Endgültiger Strukturpunkt der Zickzacklinie (ENT-102), mit Trendzustand beim Festschreiben (ENT-016)
type SPt
    int   kind
    int   bar
    float price
    int   st

// Trendzustand einer Grösse (ENT-035 … 044, 079)
type Trend
    int   st = 0
    float p1P
    int   p1B
    float p2P
    int   p2B
    float p3P
    int   p3B
    bool  p3open  = false
    bool  changed = false
    bool  korr    = false                                              // Phase: Korrektur (ENT-097)
    int   corrFrom                                                     // Bar des vorherigen P2 = Beginn der letzten Korrektur (ENT-099)
    float corrFromP
    string why    = ""                                                 // Grund des letzten Wechsels (ENT-100)
    Swing corr                                                         // Korrekturextrem nach P2, wird P3 erst beim Bruch über P2 (ENT-095)
    Swing counter
    array<Swing> after                                                 // bestätigte Wendepunkte seit P2 (Struktur beim D1-Wechsel)
    array<Swing> blue
    array<SPt>   pts                                                   // Strukturpunkte (ENT-102)
    bool  structNew = false                                            // Struktur seit dem letzten Zeichnen verändert
    int   drawn = 0                                                    // Anzahl bereits gezeichneter Strukturpunkte
    float oldUp
    float oldDn
    float extP
    int   extB

// ───────────────────────────── Struktur (ENT-102)
method sPush(Trend t, int kind, int bar, float price) =>
    int n = t.pts.size()
    SPt last = n > 0 ? t.pts.get(n - 1) : na
    bool same = not na(last) and last.bar == bar and last.kind == kind
    if not same
        if not na(last) and last.kind == kind                          // gleiche Art: extremeren behalten
            if (kind == 1 and price >= last.price) or (kind == -1 and price <= last.price)
                t.pts.set(n - 1, SPt.new(kind, bar, price, t.st))
                t.structNew := true
        else
            t.pts.push(SPt.new(kind, bar, price, t.st))
            t.structNew := true
    t

method sReplaceLast(Trend t, int kind, int bar, float price) =>
    int n = t.pts.size()
    if n > 0 and t.pts.get(n - 1).kind == kind
        t.pts.set(n - 1, SPt.new(kind, bar, price, t.st))
    else
        t.pts.push(SPt.new(kind, bar, price, t.st))
    t.structNew := true
    t

// ───────────────────────────── Kerzenregel
method step(Finder f, float cH, float cL, int cHbar, int cLbar, int gid, bool highFirst) =>
    array<Swing> res = array.new<Swing>()
    if not f.init
        f.init := true
        f.hiP := cH, f.hiLow := cL, f.hiBar := cHbar, f.hiGrp := gid
        f.loP := cL, f.loHigh := cH, f.loBar := cLbar, f.loGrp := gid
    else
        if f.hiGrp == gid
            f.hiLow := cL
        if f.loGrp == gid
            f.loHigh := cH
        for k = 0 to 1
            bool isH = (k == 0) == highFirst
            if isH
                if f.dir != -1 and cH > f.hiP
                    f.hiP := cH, f.hiLow := cL, f.hiBar := cHbar, f.hiGrp := gid
                if f.dir != 1 and gid > f.loGrp and cH >= f.loHigh + TICK
                    res.push(Swing.new(-1, f.loBar, f.loP))
                    f.dir := 1
                    f.hiP := cH, f.hiLow := cL, f.hiBar := cHbar, f.hiGrp := gid
            else
                if f.dir != 1 and cL < f.loP
                    f.loP := cL, f.loHigh := cH, f.loBar := cLbar, f.loGrp := gid
                if f.dir != -1 and gid > f.hiGrp and cL <= f.hiLow - TICK
                    res.push(Swing.new(1, f.hiBar, f.hiP))
                    f.dir := -1
                    f.loP := cL, f.loHigh := cH, f.loBar := cLbar, f.loGrp := gid
    res

// ───────────────────────────── Trend-Zustandsmaschine
method goTo(Trend t, int st, float a, int ab, float b, int bb, float c, int cb, string why) =>
    t.st := st
    t.p1P := a, t.p1B := ab, t.p2P := b, t.p2B := bb, t.p3P := c, t.p3B := cb
    t.p3open := false, t.counter := na, t.corr := na
    t.korr := false, t.corrFrom := na, t.corrFromP := na, t.why := why
    t.blue.clear()
    t.after.clear()
    t.oldUp := na, t.oldDn := na, t.extP := na, t.extB := na
    t.changed := true
    t

method goBlue(Trend t, float h, float l, int bar, string why) =>
    int   oldSt = t.st
    float op2   = t.p2P
    int   ob2   = t.p2B
    Swing cx    = t.corr
    t.st := 0
    t.p1P := na, t.p1B := na, t.p2P := na, t.p2B := na, t.p3P := na, t.p3B := na
    t.p3open := false, t.counter := na, t.corr := na
    t.korr := false, t.corrFrom := na, t.corrFromP := na, t.why := why
    t.blue.clear()
    t.after.clear()
    if oldSt == 1
        t.oldUp := op2, t.oldDn := na
        t.blue.push(Swing.new(1, ob2, op2))
        t.sPush(1, ob2, op2)
        if not na(cx)                                                  // Tief X nach P2 bleibt Teil der Struktur (ENT-092)
            t.blue.push(cx)
            t.sPush(-1, cx.bar, cx.price)
        t.extP := l, t.extB := bar
    else
        t.oldDn := op2, t.oldUp := na
        t.blue.push(Swing.new(-1, ob2, op2))
        t.sPush(-1, ob2, op2)
        if not na(cx)
            t.blue.push(cx)
            t.sPush(1, cx.bar, cx.price)
        t.extP := h, t.extB := bar
    t.changed := true
    t

// Neues Bewegungsextrem über/unter P2 (ENT-035). Alter P2 und Korrekturextrem werden
// Strukturpunkte, wenn eine Korrektur stattgefunden hat (ENT-095/102).
method p2Break(Trend t, float h, float l, int bar, bool up) =>
    int peak = up ? 1 : -1
    if t.korr or not na(t.corr)
        t.sPush(peak, t.p2B, t.p2P)
        if not na(t.corr)                                              // ENT-095: P3 erst beim Bruch über P2
            t.p3P := t.corr.price, t.p3B := t.corr.bar
            t.sPush(-peak, t.corr.bar, t.corr.price)
        t.corrFrom := t.p2B, t.corrFromP := t.p2P                      // Beginn der Korrektur (ENT-099)
    t.korr := false                                                    // Bruch über P2 = neue Bewegung (ENT-097)
    t.p2P := up ? h : l, t.p2B := bar, t.p3open := true, t.counter := na, t.corr := na
    t.after.clear()
    t

// Bruch des alten P3 nach Gegen-Wendepunkt: direkter Gegentrend (ENT-039/040, D1)
method d1(Trend t, float h, float l, int bar, bool up) =>
    int   peak = up ? 1 : -1
    Swing y    = t.counter
    float op2  = t.p2P
    int   ob2  = t.p2B
    float op3  = t.p3P
    t.sPush(peak, ob2, op2)                                            // P1 des Gegentrends
    Swing w = na
    for x in t.after                                                   // Extrem zwischen P1 und P3 (unnummeriert)
        if x.kind == -peak and x.bar < y.bar
            if na(w) or (up ? x.price < w.price : x.price > w.price)
                w := x
    if not na(w)
        t.sPush(-peak, w.bar, w.price)
    string why = "Bruch P3 " + str.tostring(op3, format.mintick) + (up ? " nach tieferem Hoch " : " nach höherem Tief ") + str.tostring(y.price, format.mintick) + " (D1)"
    t.goTo(-peak, op2, ob2, up ? l : h, bar, y.price, y.bar, why)
    t.sPush(peak, y.bar, y.price)                                      // P3 des Gegentrends
    t

method bluePriceEv(Trend t, bool isH, float h, float l, int bar) =>
    if not na(t.extP)
        if not na(t.oldUp) and not isH and l < t.extP
            t.extP := l, t.extB := bar
        if not na(t.oldDn) and isH and h > t.extP
            t.extP := h, t.extB := bar
    bool done = false
    // ENT-079: wieder über den alten P2 -> grün (Abwärts spiegelbildlich)
    if isH and not na(t.oldUp) and h >= t.oldUp + TICK
        float p3  = t.extP                                              // ENT-098: P1 = Tief seit dem Bruch, P3 = P1
        int   p3b = t.extB
        for i = t.blue.size() - 1 to 0
            if t.blue.size() == 0
                break
            Swing w = t.blue.get(i)
            if w.kind == -1 and w.bar > t.extB and w.price > t.extP
                p3 := w.price, p3b := w.bar
                break
        float e = t.extP
        int   eb = t.extB
        t.goTo(1, t.extP, t.extB, h, bar, p3, p3b, "über alten P2 " + str.tostring(t.oldUp, format.mintick) + " (ENT-079)")
        t.sReplaceLast(-1, eb, e)
        done := true
    else if not isH and not na(t.oldDn) and l <= t.oldDn - TICK
        float p3  = t.extP
        int   p3b = t.extB
        for i = t.blue.size() - 1 to 0
            if t.blue.size() == 0
                break
            Swing w = t.blue.get(i)
            if w.kind == 1 and w.bar > t.extB and w.price < t.extP
                p3 := w.price, p3b := w.bar
                break
        float e = t.extP
        int   eb = t.extB
        t.goTo(-1, t.extP, t.extB, l, bar, p3, p3b, "unter alten P2 " + str.tostring(t.oldDn, format.mintick) + " (ENT-079)")
        t.sReplaceLast(1, eb, e)
        done := true
    // ENT-042/043: Trendaufbau aus blau
    if not done and t.blue.size() >= 3
        Swing a = t.blue.get(t.blue.size() - 3)
        Swing b = t.blue.get(t.blue.size() - 2)
        Swing d = t.blue.get(t.blue.size() - 1)
        if isH and a.kind == -1 and b.kind == 1 and d.kind == -1 and d.price >= a.price + TICK and h >= b.price + TICK
            t.goTo(1, a.price, a.bar, h, bar, d.price, d.bar, "1-2-3 aus blau: über Hoch " + str.tostring(b.price, format.mintick))
        else if not isH and a.kind == 1 and b.kind == -1 and d.kind == 1 and d.price <= a.price - TICK and l <= b.price - TICK
            t.goTo(-1, a.price, a.bar, l, bar, d.price, d.bar, "1-2-3 aus blau: unter Tief " + str.tostring(b.price, format.mintick))
    t

method priceEv(Trend t, bool isH, float h, float l, int bar) =>
    if t.st == 1
        if isH and h >= t.p2P + TICK                                   // ENT-035
            t.p2Break(h, l, bar, true)
        else if not isH and l <= t.p3P - TICK                          // ENT-037
            if not na(t.counter)                                       // ENT-039/040 (D1)
                t.d1(h, l, bar, true)
            else                                                       // Skizze C/D2
                t.goBlue(h, l, bar, "Bruch P3 " + str.tostring(t.p3P, format.mintick) + " ohne tieferes Hoch")
    else if t.st == -1
        if not isH and l <= t.p2P - TICK
            t.p2Break(h, l, bar, false)
        else if isH and h >= t.p3P + TICK
            if not na(t.counter)
                t.d1(h, l, bar, false)
            else
                t.goBlue(h, l, bar, "Bruch P3 " + str.tostring(t.p3P, format.mintick) + " ohne höheres Tief")
    else
        t.bluePriceEv(isH, h, l, bar)
    t

method swingEv(Trend t, Swing sw) =>
    if t.st != 0
        if sw.bar >= t.p2B
            t.korr := true                                             // erster bestätigter Wendepunkt nach P2 (ENT-097)
        if sw.bar > t.p2B                                              // Wendepunkte seit P2 (abwechselnd, extremeren behalten)
            int m = t.after.size()
            if m > 0 and t.after.get(m - 1).kind == sw.kind
                Swing la = t.after.get(m - 1)
                if (sw.kind == 1 and sw.price > la.price) or (sw.kind == -1 and sw.price < la.price)
                    t.after.set(m - 1, sw)
            else
                t.after.push(sw)
                if t.after.size() > 50
                    t.after.shift()
    if t.st == 1
        if sw.kind == -1 and sw.bar > t.p2B                             // Tief X nach P2 (ENT-095)
            if na(t.corr) or sw.price < t.corr.price
                t.corr := sw
        else if sw.kind == -1 and not na(t.corrFrom) and sw.bar > t.corrFrom and sw.bar < t.p2B and (t.p3B <= t.corrFrom or sw.price < t.p3P)
            t.p3P := sw.price, t.p3B := sw.bar                         // nachträglich bestätigt: tiefstes Tief der Korrektur (ENT-099)
            t.sPush(1, t.corrFrom, t.corrFromP)
            t.sReplaceLast(-1, sw.bar, sw.price)
        else if sw.kind == 1 and sw.bar > t.p2B and sw.price <= t.p2P - TICK
            t.counter := sw                                            // tieferes Hoch (Hoch Y)
    else if t.st == -1
        if sw.kind == 1 and sw.bar > t.p2B
            if na(t.corr) or sw.price > t.corr.price
                t.corr := sw
        else if sw.kind == 1 and not na(t.corrFrom) and sw.bar > t.corrFrom and sw.bar < t.p2B and (t.p3B <= t.corrFrom or sw.price > t.p3P)
            t.p3P := sw.price, t.p3B := sw.bar
            t.sPush(-1, t.corrFrom, t.corrFromP)
            t.sReplaceLast(1, sw.bar, sw.price)
        else if sw.kind == -1 and sw.bar > t.p2B and sw.price >= t.p2P + TICK
            t.counter := sw
    else
        int n = t.blue.size()
        if n > 0 and t.blue.get(n - 1).kind == sw.kind
            Swing last = t.blue.get(n - 1)
            if (sw.kind == 1 and sw.price > last.price) or (sw.kind == -1 and sw.price < last.price)
                t.blue.set(n - 1, sw)
                t.sReplaceLast(sw.kind, sw.bar, sw.price)
        else
            t.blue.push(sw)
            t.sPush(sw.kind, sw.bar, sw.price)
            if t.blue.size() > 50
                t.blue.shift()
    t

// Nachträglich bestätigte Wendepunkte (ENT-083/088): hat der Kurs die Bedingung für
// den Trendaufbau aus blau (ENT-042/043) schon vorher erfüllt, wird der Wechsel nachgeholt.
method lateCheck(Trend t) =>
    if t.st == 0 and t.blue.size() >= 3
        Swing a = t.blue.get(t.blue.size() - 3)
        Swing b = t.blue.get(t.blue.size() - 2)
        Swing d = t.blue.get(t.blue.size() - 1)
        int n = math.min(bar_index - d.bar, 4900)
        if n > 0
            if a.kind == -1 and b.kind == 1 and d.kind == -1 and d.price >= a.price + TICK
                float hx = high
                int   hb = bar_index
                for k = 0 to n - 1
                    if high[k] > hx
                        hx := high[k], hb := bar_index - k
                if hx >= b.price + TICK
                    t.goTo(1, a.price, a.bar, hx, hb, d.price, d.bar, "1-2-3 aus blau (nachgeholt): über Hoch " + str.tostring(b.price, format.mintick))
            else if a.kind == 1 and b.kind == -1 and d.kind == 1 and d.price <= a.price - TICK
                float lx = low
                int   lb = bar_index
                for k = 0 to n - 1
                    if low[k] < lx
                        lx := low[k], lb := bar_index - k
                if lx <= b.price - TICK
                    t.goTo(-1, a.price, a.bar, lx, lb, d.price, d.bar, "1-2-3 aus blau (nachgeholt): unter Tief " + str.tostring(b.price, format.mintick))
    t

method runBar(Trend t, array<Swing> sws, bool highFirst) =>
    t.changed := false
    t.priceEv(highFirst, high, low, bar_index)
    t.priceEv(not highFirst, high, low, bar_index)
    for sw in sws
        t.swingEv(sw)
        t.lateCheck()
    t

// ───────────────────────────── Kausaler Tiefenfilter der GWL (ENT-084, gwl.causal_depth)
// s.get(0) ist immer der letzte endgültige Punkt, danach die offenen Kandidaten.
method gwlFeed(array<Swing> s, Swing d, float thr) =>
    array<Swing> fin = array.new<Swing>()
    s.push(d)
    if s.size() == 1
        fin.push(d)
    else
        bool changed = true
        while changed
            changed := false
            if s.size() >= 4
                for i = 1 to s.size() - 3
                    Swing a = s.get(i - 1)
                    Swing b = s.get(i)
                    Swing c = s.get(i + 1)
                    Swing e = s.get(i + 2)
                    float leg = math.abs(b.price - a.price)
                    float dep = math.abs(b.price - c.price)
                    bool cont = b.kind == 1 ? e.price > b.price : e.price < b.price
                    if leg > 0 and dep / leg < thr and cont
                        s.remove(i + 1)
                        s.remove(i)
                        changed := true
                        break
        bool go = true
        while go and s.size() >= 3
            go := false
            Swing p0 = s.get(0)
            Swing p1 = s.get(1)
            float leg = math.abs(p1.price - p0.price)
            float dep = 0.0
            for j = 2 to s.size() - 1
                Swing x = s.get(j)
                if x.kind != p1.kind
                    dep := math.max(dep, math.abs(p1.price - x.price))
            if leg > 0 and dep / leg >= thr
                fin.push(p1)
                s.shift()
                go := true
    fin

// ───────────────────────────── Zeichenhilfen
drawSeg(array<line> arr, int x1, float y1, int x2, float y2, color c, int w, string st, int cap) =>
    arr.push(line.new(x1, y1, x2, y2, color = c, width = w, style = st))
    if arr.size() > cap
        line.delete(arr.shift())

// laufender, noch nicht endgültiger Teil (blass): letzter endgültiger Punkt -> offene Kandidaten -> Kursextrem
drawPending(array<line> tmp, Swing last, array<Swing> cands, Finder f, color c, int w) =>
    array<Swing> pts = array.new<Swing>()
    if not na(last)
        pts.push(last)
    for x in cands
        if pts.size() == 0 or x.bar > pts.get(pts.size() - 1).bar
            pts.push(x)
    if pts.size() > 0
        Swing lp = pts.get(pts.size() - 1)
        if f.dir == 1 and f.hiBar > lp.bar
            pts.push(Swing.new(1, f.hiBar, f.hiP))
        else if f.dir == -1 and f.loBar > lp.bar
            pts.push(Swing.new(-1, f.loBar, f.loP))
    if pts.size() > 1
        for i = 1 to pts.size() - 1
            Swing a = pts.get(i - 1)
            Swing b = pts.get(i)
            tmp.push(line.new(a.bar, a.price, b.bar, b.price, color = c, width = w))

tfName(string tf) =>
    tf == "1" ? "1 Min" : tf == "10" ? "10 Min" : tf == "60" ? "60 Min" : tf == "D" ? "Tag" : tf == "W" ? "Woche" : tf == "M" ? "Monat" : tf

// ───────────────────────────── Zustand
var Finder sigF = Finder.new()
var Finder gwlF = Finder.new()
var Trend  sigT = Trend.new(blue = array.new<Swing>(), after = array.new<Swing>(), pts = array.new<SPt>())
var Trend  gwlT = Trend.new(blue = array.new<Swing>(), after = array.new<Swing>(), pts = array.new<SPt>())
var array<Swing> cand  = array.new<Swing>()                          // offene GWL-Kandidaten (Tiefenfilter)
var array<Swing> candS = array.new<Swing>()                          // offene Signal-Kandidaten (ENT-101)
var array<line>  sigLines = array.new<line>()
var array<line>  gwlLines = array.new<line>()

// Kerzen der GWL-Zeiteinheit (wachsend, ENT-085)
var int   gid   = 0
var float gH    = na
var float gL    = na
var int   gHbar = na
var int   gLbar = na
bool grpChg = timeframe.change(GWL_TF)
if grpChg or na(gH)
    gid += 1
    gH := high, gL := low, gHbar := bar_index, gLbar := bar_index
else
    if high > gH
        gH := high, gHbar := bar_index
    if low < gL
        gL := low, gLbar := bar_index

bool hf = (high - open) <= (open - low)          // Reihenfolge in der Kerze (ENT-024)

// ───────────────────────────── Berechnung (eine Rechenkette je Grösse, ENT-101)
array<Swing> sigRaw = sigF.step(high, low, bar_index, bar_index, bar_index, hf)
array<Swing> sigNew = array.new<Swing>()
for r in sigRaw
    if i_thrSig <= 0
        sigNew.push(r)
    else
        array<Swing> f = candS.gwlFeed(r, i_thrSig)
        for x in f
            sigNew.push(x)
sigT.runBar(sigNew, hf)

// GWL-Punkte (ENT-104): Domino nach Buch Z-06 aus den Richtungswechseln des Signaltrends,
// oder Variante C (Kerzenregel auf den Kerzen der höheren Zeiteinheit + Tiefenfilter, ENT-084)
bool DOMINO = i_method == "Domino (Buch Z-06)"
var int   legDir = 0                                                 // Richtung des laufenden GWL-Astes
var float dHi    = high
var int   dHiB   = bar_index
var float dLo    = low
var int   dLoB   = bar_index
var int   prevSt = 0
array<Swing> gwlNew = array.new<Swing>()
if DOMINO
    if high > dHi
        dHi := high, dHiB := bar_index
    if low < dLo
        dLo := low, dLoB := bar_index
    if sigT.st != prevSt
        if sigT.st == -1 and legDir != -1                            // Signal wird rot: höchstes Hoch seit dem letzten GWL-Tief ist GWL-Hoch
            gwlNew.push(Swing.new(1, dHiB, dHi))
            legDir := -1
            dLo := low, dLoB := bar_index
            for k = 0 to math.min(bar_index - dHiB, 4900)
                if low[k] < dLo
                    dLo := low[k], dLoB := bar_index - k
            dHi := high, dHiB := bar_index
        else if sigT.st == 1 and legDir != 1                         // Signal wird grün: tiefstes Tief seit dem letzten GWL-Hoch ist GWL-Tief
            gwlNew.push(Swing.new(-1, dLoB, dLo))
            legDir := 1
            dHi := high, dHiB := bar_index
            for k = 0 to math.min(bar_index - dLoB, 4900)
                if high[k] > dHi
                    dHi := high[k], dHiB := bar_index - k
            dLo := low, dLoB := bar_index
    prevSt := sigT.st
else
    array<Swing> gwlRaw = gwlF.step(gH, gL, gHbar, gLbar, gid, hf)
    for r in gwlRaw
        array<Swing> f = cand.gwlFeed(r, i_thr)
        for x in f
            gwlNew.push(x)

gwlT.runBar(gwlNew, hf)

// Phase Bewegung/Korrektur (ENT-049/097, Buch P-01/P-08): Korrektur ab dem ersten bestätigten
// Wendepunkt nach P2, Bewegung ab dem Bruch über P2
bool gwlKorr = gwlT.st != 0 and gwlT.korr
bool sigKorr = sigT.st != 0 and sigT.korr

// Grund des Farbwechsels im Chart (ENT-100)
var array<label> dbgL = array.new<label>()
dbgMark(Trend t, bool on, bool big) =>
    if on and t.changed
        string txt = stText(t.st) + "\n" + t.why
        dbgL.push(label.new(bar_index, t.st == -1 ? high : low, txt,
             style = t.st == -1 ? label.style_label_down : label.style_label_up,
             color = color.new(stColor(t.st), big ? 20 : 60), textcolor = color.white, size = big ? size.small : size.tiny))
        if dbgL.size() > 120
            label.delete(dbgL.shift())
dbgMark(gwlT, i_dbgGwl, true)
dbgMark(sigT, i_dbgSig, false)

// ───────────────────────────── Zickzack zeichnen (ENT-080/105: alle Punkte der Grösse, Farbe = Zustand bei Bestätigung)
var Swing lastSig = na
var Swing lastGwl = na
for sw in sigNew
    if i_showSig and not na(lastSig)
        drawSeg(sigLines, lastSig.bar, lastSig.price, sw.bar, sw.price, stColor(sigT.st), 1, line.style_dashed, i_maxSeg)
    lastSig := sw
for sw in gwlNew
    if i_showGwl and not na(lastGwl)
        drawSeg(gwlLines, lastGwl.bar, lastGwl.price, sw.bar, sw.price, stColor(gwlT.st), 4, line.style_solid, i_maxSeg)
    lastGwl := sw

// ───────────────────────────── Tageslinien (ENT-015/068)
type Level
    float price
    bool  isHigh
    line  ln
    label lb
    bool  active = true

var array<Level> levels = array.new<Level>()
var float dH = na
var float dL = na
var int   dHbar = na
var int   dLbar = na
var int   dTime = na
var line  openLn = na
bool dayChg = timeframe.change("D")
bool newDay = timeframe.isintraday and dayChg
if newDay
    if not na(dH) and i_showDay
        string ds = str.format_time(dTime, "dd.MM.yy", syminfo.timezone)
        levels.push(Level.new(dH, true,  line.new(dHbar, dH, bar_index, dH, color = color.new(cDn, 30), style = line.style_dotted),
             label.new(dHbar, dH, ds + "  " + str.tostring(dH, format.mintick), style = label.style_none, textcolor = color.new(cDn, 20), size = size.small)))
        levels.push(Level.new(dL, false, line.new(dLbar, dL, bar_index, dL, color = color.new(cDn, 30), style = line.style_dotted),
             label.new(dLbar, dL, ds + "  " + str.tostring(dL, format.mintick), style = label.style_none, textcolor = color.new(cDn, 20), size = size.small)))
        while levels.size() > 2 * i_days
            Level o = levels.shift()
            line.delete(o.ln)
            label.delete(o.lb)
    dH := high, dL := low, dHbar := bar_index, dLbar := bar_index, dTime := time
    if not na(openLn)
        line.delete(openLn)
    if i_showOpen
        openLn := line.new(bar_index, open, bar_index, open, color = color.gray, style = line.style_dashed)
else if timeframe.isintraday and not na(dH)
    if high > dH
        dH := high, dHbar := bar_index
    if low < dL
        dL := low, dLbar := bar_index

string dayBreak = ""
for lv in levels
    if lv.active
        if (lv.isHigh and high > lv.price) or (not lv.isHigh and low < lv.price)
            lv.active := false
            line.set_x2(lv.ln, bar_index)
            // ENT-075: Durchbruch nur in GWL-Richtung ist ein Signal
            if lv.isHigh and gwlT.st == 1
                dayBreak := "Long: Tageshoch " + str.tostring(lv.price, format.mintick) + " durchbrochen"
            else if not lv.isHigh and gwlT.st == -1
                dayBreak := "Short: Tagestief " + str.tostring(lv.price, format.mintick) + " durchbrochen"
        else
            line.set_x2(lv.ln, bar_index)
if not na(openLn)
    line.set_x2(openLn, bar_index)

// ───────────────────────────── Innenstäbe (ENT-052/054/062)
var float oH  = na
var float oL  = na
var int   oBar = na
var box   ib  = na
if IS_TF10 and i_showIB
    float fz = i_ibFuzz * TICK
    bool inside = not na(oH) and bar_index > oBar and close <= oH + fz and close >= oL - fz
    if inside
        if na(ib)
            ib := box.new(oBar, oH, bar_index, oL, border_color = color.new(color.orange, 40), bgcolor = color.new(color.orange, 88))
        else
            box.set_right(ib, bar_index)
    else
        oH := high, oL := low, oBar := bar_index
        ib := na

// ───────────────────────────── Umkehrstäbe, nur Markierung (ENT-067/069)
bool ukLong  = IS_TF10 and i_showUK and gwlT.st == 1  and gwlKorr and low  < low[1]  and close > open
bool ukShort = IS_TF10 and i_showUK and gwlT.st == -1 and gwlKorr and high > high[1] and close < open
plotshape(ukLong,  "Long-Umkehrstab",  shape.triangleup,   location.belowbar, color.new(cUp, 0), size = size.tiny)
plotshape(ukShort, "Short-Umkehrstab", shape.triangledown, location.abovebar, color.new(cDn, 0), size = size.tiny)

// ───────────────────────────── Einstiegssignal 1-2-3 (ENT-072/073)
float atr20 = ta.atr(20)
bool entry = sigT.changed and sigT.st != 0 and sigT.st == gwlT.st
bool premium = entry and not na(gwlT.p2P) and math.abs(gwlT.p2P - sigT.p2P) <= i_premAtr * atr20
if entry and i_showSigL
    label.new(bar_index, sigT.st == 1 ? low : high, (sigT.st == 1 ? "L" : "S") + (premium ? " ★" : ""),
         style = sigT.st == 1 ? label.style_label_up : label.style_label_down,
         color = stColor(sigT.st), textcolor = color.white, size = size.small)

// ───────────────────────────── Alerts (Stufe 1, ENT-020)
if gwlT.changed
    alert(syminfo.ticker + " GWL (" + GWL_TF + "): " + stText(gwlT.st), alert.freq_once_per_bar)
if entry
    alert(syminfo.ticker + (premium ? " PREMIUM " : " ") + "1-2-3 " + (sigT.st == 1 ? "LONG" : "SHORT") +
         " | Signal-P2 " + str.tostring(sigT.p2P, format.mintick) + " | Stopp P3 " + str.tostring(sigT.p3P, format.mintick), alert.freq_once_per_bar)
if dayBreak != ""
    alert(syminfo.ticker + " " + dayBreak, alert.freq_once_per_bar)

// ───────────────────────────── Letzte Kerze: laufender Ast, Punkte, Bruchlinien, Tabelle
var array<line>  tmpL = array.new<line>()
var array<label> tmpB = array.new<label>()
if barstate.islast
    for x in tmpL
        line.delete(x)
    for x in tmpB
        label.delete(x)
    tmpL.clear()
    tmpB.clear()
    // laufender, noch nicht endgültiger Teil je Grösse (ENT-083/105), blass
    if i_showGwl
        if DOMINO
            if not na(lastGwl)
                float eP = legDir == -1 ? dLo : dHi
                int   eB = legDir == -1 ? dLoB : dHiB
                if eB > lastGwl.bar
                    tmpL.push(line.new(lastGwl.bar, lastGwl.price, eB, eP, color = color.new(stColor(gwlT.st), 60), width = 4))
        else
            drawPending(tmpL, lastGwl, cand, gwlF, color.new(stColor(gwlT.st), 60), 4)
    if i_showSig
        drawPending(tmpL, lastSig, candS, sigF, color.new(stColor(sigT.st), 50), 1)
    // Punkte 1-2-3 der GWL (gross) und der Signallage (klein)
    if gwlT.st != 0 and i_showGwl
        bool up = gwlT.st == 1
        tmpB.push(label.new(gwlT.p1B, gwlT.p1P, "1", style = up ? label.style_label_up : label.style_label_down, color = color.new(stColor(gwlT.st), 0), textcolor = color.white))
        tmpB.push(label.new(gwlT.p2B, gwlT.p2P, "2", style = up ? label.style_label_down : label.style_label_up, color = color.new(stColor(gwlT.st), 0), textcolor = color.white))
        tmpB.push(label.new(gwlT.p3B, gwlT.p3P, "3", style = up ? label.style_label_up : label.style_label_down, color = color.new(stColor(gwlT.st), 0), textcolor = color.white))
        tmpL.push(line.new(gwlT.p3B, gwlT.p3P, bar_index + 15, gwlT.p3P, color = stColor(gwlT.st), width = 2))
        // vorläufiger P3 in Klammern: Tief X, wird erst beim Bruch über P2 zum P3 (ENT-095)
        if not na(gwlT.corr)
            tmpB.push(label.new(gwlT.corr.bar, gwlT.corr.price, "(3)", style = up ? label.style_label_up : label.style_label_down, color = color.new(stColor(gwlT.st), 50), textcolor = color.white))
    if sigT.st != 0 and i_showSig
        bool up2 = sigT.st == 1
        tmpB.push(label.new(sigT.p2B, sigT.p2P, "s2", style = label.style_none, textcolor = stColor(sigT.st), size = size.small))
        tmpB.push(label.new(sigT.p3B, sigT.p3P, "s3", style = label.style_none, textcolor = stColor(sigT.st), size = size.small))
        tmpL.push(line.new(sigT.p3B, sigT.p3P, bar_index + 10, sigT.p3P, color = stColor(sigT.st), style = line.style_dotted))
        if not na(sigT.corr)
            tmpB.push(label.new(sigT.corr.bar, sigT.corr.price, "(s3)", style = label.style_none, textcolor = color.new(stColor(sigT.st), 30), size = size.small))

var table tab = table.new(TAB_POS, 4, 3, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast and i_showTab
    table.cell(tab, 0, 0, "Grösse", text_color = color.white)
    table.cell(tab, 1, 0, "Trend", text_color = color.white)
    table.cell(tab, 2, 0, "Phase", text_color = color.white)
    table.cell(tab, 3, 0, "Bruchlinie", text_color = color.white)
    table.cell(tab, 0, 1, "GWL (" + tfName(GWL_TF) + ")", text_color = color.white)
    table.cell(tab, 1, 1, stText(gwlT.st), bgcolor = stColor(gwlT.st), text_color = color.white)
    table.cell(tab, 2, 1, gwlT.st == 0 ? "–" : gwlKorr ? "Korrektur" : "Bewegung", text_color = color.white)
    table.cell(tab, 3, 1, na(gwlT.p3P) ? "–" : str.tostring(gwlT.p3P, format.mintick), text_color = color.white)
    table.cell(tab, 0, 2, "Signal (" + tfName(timeframe.period) + ")", text_color = color.white)
    table.cell(tab, 1, 2, stText(sigT.st), bgcolor = stColor(sigT.st), text_color = color.white)
    table.cell(tab, 2, 2, sigT.st == 0 ? "–" : sigKorr ? "Korrektur" : "Bewegung", text_color = color.white)
    table.cell(tab, 3, 2, na(sigT.p3P) ? "–" : str.tostring(sigT.p3P, format.mintick), text_color = color.white)
